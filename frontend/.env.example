# Firebase Web SDK config for the `linexrewards-app` project. Not secret —
# already defaulted in src/firebase.js (the project hit its Firebase
# web-app-registration quota, so linexAcademy reuses the shared project
# browser key/appId rather than getting its own "app" entry). Only override
# these if that changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ultragroup Entra ID tenant — see docs/org-context.md. Defaults to the real
# value in src/firebase.js, only override for a different tenant.
VITE_ENTRA_TENANT_ID=e4f9385c-add2-4a84-9c23-9353fc6059da

# URL of the backend Cloud Run service (see backend/).
VITE_API_BASE_URL=http://localhost:8081
