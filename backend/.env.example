# Firestore named database (see docs/org-context.md — apps in linexrewards-app
# each get their own named database, never the (default) one).
FIRESTORE_DATABASE_ID=linex-academy

# GCP project hosting Firestore/Auth. Only needed for local dev against the
# Firestore emulator or when running outside Cloud Run (where ADC already
# knows the project).
GOOGLE_CLOUD_PROJECT=linexrewards-app

# Corporate email domains allowed to self-provision on first Microsoft SSO
# login (comma-separated). See roles_permisos.md.
ALLOWED_EMAIL_DOMAINS=ultragroupla.com,linextravel.com,linex-loyalty.com

# Origin(s) allowed to call this API (the frontend's deployed URL). Comma
# separated for multiple (e.g. prod + local dev).
CORS_ORIGINS=http://localhost:5173

PORT=8081
